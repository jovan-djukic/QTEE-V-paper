	keywords = {Computer Science - Cryptography and Security, Computer Science - Hardware Architecture},
	file = {Full Text PDF:/home/dj/Zotero/storage/DHGIJ3C7/Sahita et al. - 2023 - CoVE Towards Confidential Computing on RISC-V Platforms.pdf:application/pdf;Snapshot:/home/dj/Zotero/storage/QRBMFZLL/2304.html:text/html},
}

@misc{ozga_ace_2025,
