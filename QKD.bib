	pages = {80},
	file = {Full Text PDF:/home/dj/Zotero/storage/6T6GRC33/Martin et al. - 2024 - MadQCI a heterogeneous and scalable SDN-QKD network deployed in production facilities.pdf:application/pdf},
}

